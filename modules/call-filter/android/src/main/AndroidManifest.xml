<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.READ_CALL_LOG" />

  <!-- para ver si el SIM Toolkit (publicidad de la SIM) está activo -->
  <queries>
    <package android:name="com.android.stk" />
    <package android:name="com.android.stk2" />
  </queries>

  <application>
    <service
      android:name="expo.modules.callfilter.FilterScreeningService"
      android:exported="true"
      android:permission="android.permission.BIND_SCREENING_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.CallScreeningService" />
      </intent-filter>
    </service>

    <!-- atajos en Ajustes rápidos -->
    <service
      android:name="expo.modules.callfilter.FilterTileService"
      android:exported="true"
      android:icon="@drawable/ic_tile_filter"
      android:label="Filtro de llamadas"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <service
      android:name="expo.modules.callfilter.QuietTileService"
      android:exported="true"
      android:icon="@drawable/ic_tile_quiet"
      android:label="No molestar (llamadas)"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!-- "¿Era spam?": fin de llamada y botón de la notificación -->
    <receiver android:name="expo.modules.callfilter.CallEndReceiver" android:exported="true"
      android:permission="android.permission.READ_PHONE_STATE">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>
    <receiver android:name="expo.modules.callfilter.MarkSpamReceiver" android:exported="false" />
  </application>
</manifest>
